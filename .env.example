APP_NAME=KnowledgeHub
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://knowledgehub:knowledgehub@localhost:5432/knowledgehub

JWT_SECRET_KEY=replace-with-a-secure-random-secret

DOCUMENT_STORAGE_PATH=storage/documents

# Answer generation provider:
# deterministic | openai | gemini
ANSWER_GENERATION_PROVIDER=deterministic

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash